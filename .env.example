# Cloudflare Pages secrets / env vars for markdown upload admin
# Set these in Cloudflare Pages → Settings → Environment variables
# For local Pages Functions: copy to .dev.vars (never commit secrets)

# Shared password for /admin uploads
ADMIN_PASSWORD=

# Fine-grained GitHub PAT with Contents: Read and write on this repo
GITHUB_TOKEN=

# Repository target (defaults match this project's remote)
GITHUB_OWNER=VivekGupta137
GITHUB_REPO=vgblog
GITHUB_BRANCH=master
