# Environment reference for sdeway.com
#
# Plain vars are defined in wrangler.jsonc (Wrangler-managed project).
# The Cloudflare Dashboard only accepts Secrets for this project.
#
# Local Astro: copy needed keys into .env (gitignored).
# Local Pages Functions: use .dev.vars (gitignored).

# --- Secrets (Dashboard → Variables and Secrets) ---
ADMIN_PASSWORD=
GITHUB_TOKEN=

# --- Plain vars (also in wrangler.jsonc → vars) ---
PUBLIC_DOMAIN=https://www.sdeway.com/
PUBLIC_GISCUS_CATEGORY=General
PUBLIC_GISCUS_CATEGORY_ID=DIC_kwDOQYyqE84Cx9pf
PUBLIC_GISCUS_REPO=VivekGupta137/docs-giscus
PUBLIC_GISCUS_REPO_ID=R_kgDOQYyqEw
# Kroki base URL for all diagram types (plantuml, mermaid, d2, diagramsnet, …)
# Required for local `astro build` / `astro dev` — wrangler.jsonc vars are NOT loaded by Astro.
PUBLIC_KROKI_SERVER_URL=http://192.119.118.215:8000
# Legacy PlantUML-only URL (origin used as fallback if KROKI unset)
PUBLIC_PLANTUML_SERVER_URL=http://192.119.118.215:8000
GITHUB_OWNER=VivekGupta137
GITHUB_REPO=vgblog
GITHUB_BRANCH=master

# Optional: enable starlight-links-validator (off by default — flaky on CF with Starlight 0.36)
# VALIDATE_LINKS=true
